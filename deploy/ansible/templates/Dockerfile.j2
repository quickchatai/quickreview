# Review sandbox runtime — single container, plain Ubuntu base.
# Built by the ansible; managed by ansible/docker, never hand-edited on the VM.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ={{ timezone }}

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq ripgrep openssh-client gnupg tzdata sqlite3 \
      build-essential python3 \
    && rm -rf /var/lib/apt/lists/*

# tmux {{ tmux_version }} from source — 24.04's apt tmux is 3.4, below the
# ≥3.5 needed for `extended-keys-format csi-u` (modified keys reaching pi).
RUN apt-get update && apt-get install -y --no-install-recommends \
      libevent-dev libncurses-dev bison pkg-config \
    && curl -fsSL https://github.com/tmux/tmux/releases/download/{{ tmux_version }}/tmux-{{ tmux_version }}.tar.gz \
      | tar xz -C /tmp \
    && cd /tmp/tmux-{{ tmux_version }} && ./configure && make -j"$(nproc)" && make install \
    && rm -rf /tmp/tmux-{{ tmux_version }} \
    && apt-get purge -y bison && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# Node {{ node_major }} (NodeSource)
RUN curl -fsSL https://deb.nodesource.com/setup_{{ node_major }}.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# pi — pinned, never floating
RUN npm install -g {{ pi_npm_package }}@{{ pi_version }}

# pi-memory extension — pinned, never floating. The npm name is collided with
# unrelated packages (josephkern/catlain/@chendpoc): hard-fail the build unless
# the INSTALLED package's repository resolves to github.com/jayzeng/pi-memory.
RUN npm install -g {{ pi_memory_package }}@{{ pi_memory_version }} \
    && url="$(node -p "String((require(require('child_process').execSync('npm root -g').toString().trim() + '/{{ pi_memory_package }}/package.json').repository || {}).url)")" \
    && echo "pi-memory repository.url: $url" \
    && echo "$url" | grep -Eq 'github\.com[:/]jayzeng/pi-memory' \
    || { echo "FATAL: {{ pi_memory_package }}@{{ pi_memory_version }} is not jayzeng/pi-memory" >&2; exit 1; }

# qmd — the semantic-search CLI pi-memory's `memory_search` shells out to
#. Same provenance discipline as pi-memory even though the name is
# scoped: hard-fail unless the installed package's repository resolves to
# github.com/tobi/qmd, and smoke the binary in the layer — its node-llama-cpp
# native dep must actually load, not just install.
RUN npm install -g {{ qmd_npm_package }}@{{ qmd_version }} \
    && url="$(node -p "String((require(require('child_process').execSync('npm root -g').toString().trim() + '/{{ qmd_npm_package }}/package.json').repository || {}).url)")" \
    && echo "qmd repository.url: $url" \
    && echo "$url" | grep -Eq 'github\.com[:/]tobi/qmd' \
    && qmd --version \
    || { echo "FATAL: {{ qmd_npm_package }}@{{ qmd_version }} failed verification (not tobi/qmd, or the binary does not run)" >&2; exit 1; }

# pi-subagents extension — amosblomqvist/pi-subagents is a raw extension repo
# (no package.json, NOT on npm; the npm/pi.dev "pi-subagents" name belongs to
# nicobailon's unrelated package). Pin by exact commit; verify the checkout.
RUN git clone {{ pi_subagents_repo }} /opt/pi-extensions/pi-subagents \
    && git -C /opt/pi-extensions/pi-subagents checkout --detach {{ pi_subagents_commit }} \
    && [ "$(git -C /opt/pi-extensions/pi-subagents rev-parse HEAD)" = "{{ pi_subagents_commit }}" ] \
    && rm -rf /opt/pi-extensions/pi-subagents/.git \
    && test -f /opt/pi-extensions/pi-subagents/index.ts \
    && echo "{{ pi_subagents_commit }}" > /opt/pi-extensions/pi-subagents/.pinned-commit

RUN useradd --create-home --uid 1001 review
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

USER review
WORKDIR /opt/quickreview/sandbox
EXPOSE {{ webhook_port }}

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
