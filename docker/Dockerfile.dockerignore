# The release image's build context (docker/Dockerfile). BuildKit reads this
# file in preference to the root .dockerignore, which is the companion
# image's allowlist (src/appstamp.ts BAKED_PATHS). Admits only what the
# release image copies; everything else in the checkout stays out.
*
!package.json
!package-lock.json
!tsconfig.json
!packages
!plugins/qcr/render.mjs
!plugins/qcr/render.d.mts
!plugins/qcr/templates
!src
!extensions
!agents
!prompts
!seeds
!profiles
!schemas
!scripts
!config.example.toml
!docker/entrypoint.sh
!docker/setid/qcr-setid.c
!docker/vm/tmux.conf
!docker/companion/agents
!docker/companion/memory-health.mjs
!docker-compose.yml
!docker/tunnel
!tests/fixtures/seed-manifest.json
!deploy/reviewer/AGENTS.override.md
**/node_modules
**/.git
# A package's build output, its packed data and the Plugin's rendered skills
# are built in the image, never carried in from the checkout.
packages/*/dist
packages/*/assets
packages/pi-plugin/skills
# Agent instruction files, never in an image.
**/CLAUDE.md
