-function localISO() {
-  const d = new Date();
-  const off = d.getTimezoneOffset();
-  const sign = off <= 0 ? "+" : "-";
-  const abs = Math.abs(off);
-  const local = new Date(d.getTime() - off * 60000);
-  return local.toISOString().replace(
-    "Z",
-    `${sign}${String(Math.floor(abs / 60)).padStart(2, "0")}:${String(abs % 60).padStart(2, "0")}`,
