+  let routed: string | null = null;
+  for (const [i, raw] of params.entries.entries()) {
+    const entry = (raw && typeof raw === "object" ? raw : {}) as BatchEntryInput;
+    const each = routeNamespace({ uri: entry.uri, namespace: params.namespace }, names);
