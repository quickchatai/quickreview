#!/usr/bin/env bash
# qcr — thin wrapper around the compiled CLI (src/cli.ts → dist/src/cli.js).
# Builds once if dist is missing so a fresh checkout still works.
set -euo pipefail

# readlink -f: survive being invoked through a symlink (e.g. ~/.local/bin/qcr)
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CLI="$ROOT/dist/src/cli.js"

if [[ ! -f "$CLI" ]]; then
  echo "qcr: dist missing, building…" >&2
  (cd "$ROOT" && npm run --silent build >&2)
fi

exec node "$CLI" "$@"
