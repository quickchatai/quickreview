node_modules/
dist/
# The data a workspace package's prepack copies in from the root (prompts/,
# agents/, seeds/, …) and the LICENSE: the root copy is the one source.
/packages/*/assets/
/packages/*/LICENSE
state/*
!state/.gitkeep
inject/*
!inject/.gitkeep
verdict/*
!verdict/.gitkeep
commands/*
!commands/.gitkeep
digest/*
!digest/.gitkeep
archive/*
!archive/.gitkeep
memory/*
!memory/.gitkeep
!memory/README.md
wt/
# The base clone (<sandbox root>/<[github] clone_dir>) is NOT listed here: its
# name is per-install, so scripts/deploy.sh writes it into the LOCAL
# .git/info/exclude instead — a tracked line would name one repo.
# The daemon's WorktreeManager.ensureBaseClone writes the same line when the
# sandbox root is a checkout (npm run daemon, the plain-docker bind mount).
# Finished-round evidence copied down from the VM. The default store
# lives outside the repo (~/.local/share/qcr/evidence) because it grows without
# bound; this covers an in-repo `[companion] evidence_dir` (and the empty-string
# default of <root>/evidence). Private-repo transcripts never get committed.
# Root-anchored so it does not also match skills/companion/evidence/.
/evidence/
reports/
pihome/
*.log
BUILD_SHA
state-snapshots/
# The live inventory is operator-local (real hostnames); the tracked
# template is inventory.example.ini — copy it to inventory.ini and fill in.
deploy/ansible/inventory.ini

# An adopter's filled config must never be committed (identity + infra
# values). No effect on the private deployment: this file is already
# tracked there, and gitignore never affects tracked files.
/config.toml

# Compose's project env file — the onboarding wizard writes the
# chosen ingress profile (COMPOSE_PROFILES) here, and operators add their own
# QCR_* overrides beside it. Operator-local, never committed.
/.env

# DigitalOcean benchmark model access key, supplied locally via --env-file.
/bench/aacr/digitalocean.env

# Gemini API key for open/other-model benchmark reviews (QCR_BENCH_PROVIDER=google).
/bench/aacr/google.env

# Worktree build artifacts: agents symlink node_modules into a worktree (a symlink is
# not matched by `node_modules/`) and keep an incremental tsbuildinfo beside it.
node_modules
.cache/
*.tsbuildinfo
.tsbuildinfo*

# Contributor-local Claude Code state (the tracked .claude/ config stays tracked).
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.*
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local

# Editor and OS droppings.
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# Test coverage and Python byproducts.
coverage/
__pycache__/
*.pyc
.venv/

# Secrets: per-environment env files and key material.
.env.*
!.env.example
*.pem
*.key

# selfimprove skill settings and ledger
.selfimprove/

# Agents a clone-route bench builds into the checkout it runs from
# (buildBenchAgents → .pi/agents); .pi/settings.json stays tracked.
.pi/agents/
